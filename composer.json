{
    "name": "setono/gls-webservice-bundle",
    "description": "Symfony bundle that integrates the GLS webservice PHP SDK",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "setono",
        "gls"
    ],
    "require": {
        "php": ">=8.2",
        "ext-soap": "*",
        "setono/gls-webservice-php-sdk": "^2.2",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "matthiasnoback/symfony-config-test": "^6.2",
        "matthiasnoback/symfony-dependency-injection-test": "^6.3",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "setono/code-quality-pack": "^3.4",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\GlsWebserviceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\GlsWebserviceBundle\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
